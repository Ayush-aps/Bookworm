<!-- views/layouts/main.ejs - Updated with correct structure -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> sidebar </title>
  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- Main CSS -->
  <link rel="stylesheet" href="/css/main.css">
  <!-- Sidebar CSS -->
  <link rel="stylesheet" href="/css/sidebar.css">
  <!-- Bookish Theme CSS -->
  <link rel="stylesheet" href="/css/bookish-theme.css">
</head>

<style>
    /* public/css/main.css */
body {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  overflow-x: hidden;
}

.main-content {
  margin-left: var(--sidebar-width);
  padding: 20px;
  min-height: calc(100vh - var(--header-height));
  margin-top: var(--header-height);
  transition: margin-left 0.3s ease;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .main-content {
    margin-left: 0;
    width: 100%;
  }
  
  /* Add mobile menu toggle for the header if needed */
  .mobile-menu-toggle {
    display: block;
    cursor: pointer;
  }
}
</style>
<body>
  <!-- Header -->
  <%- include('../partials/header') %>
  
  <!-- Sidebar -->
  <%- include('../partials/sidebar') %>
  
  <!-- Main Content - Content will appear to the right of the sidebar -->
  <div class="main-content">
    <%- body %>
  </div>
  
  <script src="/js/sidebar.js"></script>
</body>
</html>