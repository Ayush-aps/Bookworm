<!-- views/header.ejs -->
<header>
  <nav class="navbar">
    <!-- Left: Logo -->
    <div class="logo">
      <img src="/assets/logo.png" alt="logo" style="width: 120px;">
      <div class="nav-title">
        <!-- <a href="/"><h1>Bookworm</h1></a> -->
      </div>
    </div>
    <!-- Right: Theme Toggle, User Info & Hamburger Menu -->
    <div class="nav-actions">
      <button id="theme-toggle">🌓</button>
      <div class="user-info">
        <% if (user) { %>
          Welcome, <%= user.username %> 
        <% } %>
      </div>
      <div class="hamburger-menu" onclick="toggleMenu()">
        <div class="menu-icon">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="menu-links">
          <a href="/">Home</a>
          <a href="/books/shopnow">Shop Now</a>
          <a href="/userpage">User Dashboard</a>
          <a href="/sell">Sell Books</a>
          <a href="/readonline">Read Online</a>
        </div>
      </div>
    </div>
  </nav>
</header>